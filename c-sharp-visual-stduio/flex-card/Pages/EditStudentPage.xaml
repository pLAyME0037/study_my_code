<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="user_info.Pages.EditStudentPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">


            <Grid ColumnDefinitions="150,*"
                  RowSpacing="12"
                  ColumnSpacing="15">
                <Label Text="Email"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                    x:Name="Email"
                    Placeholder="Enter Email"
                    Keyboard="Email" />
            </Grid>

            <Grid ColumnDefinitions="150,*"
                  RowSpacing="12"
                  ColumnSpacing="15">
                <Label Text="Phone"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                    x:Name="Phone"
                    Placeholder="Enter Phone"
                    Keyboard="Telephone" />
            </Grid>

            <Button Text="Save" 
                WidthRequest="120" />
            <Button Text="Back" 
                WidthRequest="120"
                Clicked="GoBack"/>
            <Button Text="Home" 
                WidthRequest="120"
                Clicked="GoHome"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>



