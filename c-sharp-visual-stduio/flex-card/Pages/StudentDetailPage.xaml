<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="user_info.Pages.StudentDetailPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Grid ColumnDefinitions="150,*"
                  RowSpacing="12"
                  ColumnSpacing="15">
                <Label Text="Email"
                       VerticalOptions="Center" />
                <Label Text="smith@gmail.com"
                       VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="150,*"
                  RowSpacing="12"
                  ColumnSpacing="15">
                <Label Text="Phone"
                       VerticalOptions="Center" />
                <Label Text="09343434345"
                       VerticalOptions="Center" />
            </Grid>
            <Button Text="Edit Student"
                Clicked="EditStudent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>



