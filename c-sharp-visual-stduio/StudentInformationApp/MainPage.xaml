<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentInformationApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Student Informatioin" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>

            <Label Text="Student ID"/>
            <Entry Text="{Binding StudentId}"/>
            <Label Text="Name"/>
            <Entry Text="{Binding Name}"/>
            <Label Text="Major"/>
            <Entry Text="{Binding Major}"/>
            <Label Text="GPA"/>
            <Entry Text="{Binding Gpa}"/>

            <Button Text="Load Student" 
                    Command="{Binding LoadStudentCommand}"/>

            <Button Text="Clear" 
                    Command="{Binding ClearCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
