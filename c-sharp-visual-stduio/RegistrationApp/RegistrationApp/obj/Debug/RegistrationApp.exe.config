<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<connectionStrings>
		<add name="ConnectionStringName" providerName="System.Data.SqlClient" connectionString="Data Source=127.0.0.1,1433;
Initial Catalog=register; Integrated Security=False;User ID=register;Password=12345678; MultipleActiveResultSets=True"/>
		
		<!-- Current: local named instance -->
		<add name="RegistrationApp" connectionString="Server=.\sql2019;Database=RegistrationApp;Trusted_Connection=True;" providerName="System.Data.SqlClient" />

		<!-- LocalDB (Visual Studio default) -->
		<add name="RegistrationApp.LocalDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=RegistrationApp;Integrated Security=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>