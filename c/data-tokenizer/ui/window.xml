<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkPaned" id="main_paned">
    <property name="wide-handle">1</property>
    <property name="position">180</property>
    <property name="resize-start-child">0</property>
    <property name="shrink-start-child">0</property>

    <child>
      <object class="GtkStackSidebar" id="sidebar">
        <property name="stack">content_stack</property>
      </object>
    </child>

    <child>
      <object class="GtkStack" id="content_stack">
        <property name="transition-type">slide-left-right</property>
        <property name="transition-duration">200</property>

        <child>
          <object class="GtkStackPage">
            <property name="name">home</property>
            <property name="title" translatable="yes">Home</property>
            <property name="child">
              <object class="GtkBox" id="home_page">
                <property name="orientation">vertical</property>
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="spacing">12</property>

                <child>
                  <object class="GtkLabel" id="title_label">
                    <property name="label" translatable="yes">Data Tokenizer</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="1.8"/>
                    </attributes>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="subtitle_label">
                    <property name="label" translatable="yes">Select a JSON file to scan for sensitive data.</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSeparator"/>
                </child>

                <child>
                  <object class="GtkBox" id="file_row">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkEntry" id="file_entry">
                        <property name="hexpand">1</property>
                        <property name="placeholder-text">Select a JSON file...</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="browse_btn">
                        <property name="label" translatable="yes">Browse</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkCheckButton" id="confirm_check">
                    <property name="label" translatable="yes">Review sensitive fields after scan</property>
                    <property name="active">1</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="status_label">
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="btn_row">
                    <property name="orientation">horizontal</property>
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton" id="cancel_btn">
                        <property name="label" translatable="yes">Cancel</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="submit_btn">
                        <property name="label" translatable="yes">Submit</property>
                        <style><class name="suggested-action"/></style>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="GtkStackPage">
            <property name="name">confirm</property>
            <property name="title" translatable="yes">Confirm Sensitivity</property>
            <property name="child">
              <object class="GtkBox" id="confirm_page">
                <property name="orientation">vertical</property>
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="spacing">12</property>

                <child>
                  <object class="GtkLabel" id="confirm_title">
                    <property name="label" translatable="yes">Review Sensitive Fields</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="1.8"/>
                    </attributes>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="confirm_desc">
                    <property name="label" translatable="yes">Uncheck any fields that are NOT sensitive, then click Apply.</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSeparator"/>
                </child>

                <child>
                  <object class="GtkBox" id="confirm_header">
                    <property name="orientation">horizontal</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">4</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel" id="chk_hdr_sel">
                        <property name="label" translatable="yes">Sensitive</property>
                        <property name="width-chars">10</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="chk_hdr_name">
                        <property name="label" translatable="yes">Field Name</property>
                        <property name="width-chars">20</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="chk_hdr_sample">
                        <property name="label" translatable="yes">Sample Value</property>
                        <property name="hexpand">1</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="chk_hdr_level">
                        <property name="label" translatable="yes">Level</property>
                        <property name="width-chars">6</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkScrolledWindow" id="confirm_scroll">
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkListBox" id="confirm_list">
                        <property name="activate-on-single-click">0</property>
                        <style><class name="boxed-list"/></style>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="confirm_btn_row">
                    <property name="orientation">horizontal</property>
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton" id="confirm_back_btn">
                        <property name="label" translatable="yes">Back</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="confirm_apply_btn">
                        <property name="label" translatable="yes">Apply</property>
                        <style><class name="suggested-action"/></style>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="GtkStackPage">
            <property name="name">results</property>
            <property name="title" translatable="yes">Results</property>
            <property name="child">
              <object class="GtkBox" id="results_page">
                <property name="orientation">vertical</property>
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="results_title">
                    <property name="label" translatable="yes">Analysis Results</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="1.8"/>
                    </attributes>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="summary_label">
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="results_header">
                    <property name="orientation">horizontal</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">4</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel" id="hdr_no">
                        <property name="label" translatable="yes">No</property>
                        <property name="width-chars">5</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="hdr_user">
                        <property name="label" translatable="yes">User</property>
                        <property name="width-chars">6</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="hdr_path">
                        <property name="label" translatable="yes">Path</property>
                        <property name="hexpand">1</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="hdr_val">
                        <property name="label" translatable="yes">Value</property>
                        <property name="hexpand">1</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="hdr_lvl">
                        <property name="label" translatable="yes">Level</property>
                        <property name="width-chars">6</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="hdr_sens">
                        <property name="label" translatable="yes">Sensitive</property>
                        <property name="width-chars">10</property>
                        <property name="xalign">0</property>
                        <attributes><attribute name="weight" value="bold"/></attributes>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkSeparator"/>
                </child>

                <child>
                  <object class="GtkScrolledWindow" id="results_scroll">
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkListBox" id="results_list">
                        <property name="activate-on-single-click">0</property>
                        <style><class name="boxed-list"/></style>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </child>

      </object>
    </child>

  </object>
</interface>
