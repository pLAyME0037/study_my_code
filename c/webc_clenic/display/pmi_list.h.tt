<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Patient Medicine Invoice</h2>

    <form method="POST" action="/patient-medicine-invoices/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">New Invoice</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Patient</label>
                <select name="patient_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < patient_opts->count; ++i) { })
                        <option value="({ LLINT(patient_opts->items[i].id); })">({ ESCAPED(patient_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Invoice Date</label>
                <input name="invoice_date" type="date"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Amount (Riel)</label>
                <input name="amount_in_riel" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Amount ($)</label>
                <input name="amount_in_dollar" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
        </div>
        <button type="submit" class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Create</button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">#</th>
                    <th class="px-4 py-3 font-semibold">Patient</th>
                    <th class="px-4 py-3 font-semibold">Date</th>
                    <th class="px-4 py-3 font-semibold">Amount Riel</th>
                    <th class="px-4 py-3 font-semibold">Amount $</th>
                    <th class="px-4 py-3 font-semibold">Details</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows->count == 0) { })
                    <tr>
                        <td colspan="7" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">No invoices yet.</td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows->count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-500 dark:text-gray-400">({ LLINT(rows->items[i].id); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].patient_name); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows->items[i].invoice_date); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].amount_in_riel); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].amount_in_dollar); })</td>
                        <td class="px-4 py-2"><a href="/patient-medicine-invoices/({ LLINT(rows->items[i].id); })/details"
                                                class="text-indigo-600 dark:text-indigo-400 hover:underline">({ INT(rows->items[i].detail_count); }) detail(s)</a></td>
                        <td class="px-4 py-2 whitespace-nowrap">
                            <a href="/patient-medicine-invoices/({ LLINT(rows->items[i].id); })/edit"
                               class="mr-2 px-2 py-1 rounded text-xs bg-amber-500 hover:bg-amber-600 text-white">Edit</a>
                            <form method="POST" action="/patient-medicine-invoices/({ LLINT(rows->items[i].id); })/delete" class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">Delete</button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
</div>