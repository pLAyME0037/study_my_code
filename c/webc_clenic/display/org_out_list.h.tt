<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Organization Invoice Out</h2>

    <form method="POST" action="/organization-invoice-out/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">New Invoice Out</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Organization</label>
                <select name="organization_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < org_opts->count; ++i) { })
                        <option value="({ LLINT(org_opts->items[i].id); })">({ ESCAPED(org_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Patient</label>
                <select name="patient_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < patient_opts->count; ++i) { })
                        <option value="({ LLINT(patient_opts->items[i].id); })">({ ESCAPED(patient_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Room</label>
                <select name="room_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < room_opts->count; ++i) { })
                        <option value="({ LLINT(room_opts->items[i].id); })">({ ESCAPED(room_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Room Price</label>
                <input name="room_price" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Start Date</label>
                <input name="start_date" type="date"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">End Date</label>
                <input name="end_date" type="date"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Room Days</label>
                <input name="room_day" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
        </div>
        <button type="submit" class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Create</button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">#</th>
                    <th class="px-4 py-3 font-semibold">Organization</th>
                    <th class="px-4 py-3 font-semibold">Patient</th>
                    <th class="px-4 py-3 font-semibold">Room</th>
                    <th class="px-4 py-3 font-semibold">Start</th>
                    <th class="px-4 py-3 font-semibold">End</th>
                    <th class="px-4 py-3 font-semibold">Details</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows->count == 0) { })
                    <tr>
                        <td colspan="8" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">No invoice-out records yet.</td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows->count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-500 dark:text-gray-400">({ LLINT(rows->items[i].id); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].org_name); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].patient_name); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].room_name); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows->items[i].start_date); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows->items[i].end_date); })</td>
                        <td class="px-4 py-2"><a href="/organization-invoice-out/({ LLINT(rows->items[i].id); })/details"
                                                class="text-indigo-600 dark:text-indigo-400 hover:underline">({ INT(rows->items[i].detail_count); }) detail(s)</a></td>
                        <td class="px-4 py-2 whitespace-nowrap">
                            <a href="/organization-invoice-out/({ LLINT(rows->items[i].id); })/edit"
                               class="mr-2 px-2 py-1 rounded text-xs bg-amber-500 hover:bg-amber-600 text-white">Edit</a>
                            <form method="POST" action="/organization-invoice-out/({ LLINT(rows->items[i].id); })/delete" class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">Delete</button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
</div>