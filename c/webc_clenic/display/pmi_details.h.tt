<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">Medicine Invoice #({ LLINT(import_id); })</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Patient: ({ ESCAPED(patient_name); }) &middot; Date: ({ ESCAPED(invoice_date); })</p>

    <form method="POST" action="/patient-medicine-invoices/({ LLINT(import_id); })/details/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">Add Medicine</h3>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Medicine</label>
                <select name="medicine_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < med_opts->count; ++i) { })
                        <option value="({ LLINT(med_opts->items[i].id); })">({ ESCAPED(med_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Qty</label>
                <input name="qty" type="number" step="any" required
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Price</label>
                <input name="price" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Amount</label>
                <input name="amount" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Currency</label>
                <input name="currency" type="text" placeholder="USD / KHR"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
        </div>
        <button type="submit" class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Add</button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">Medicine</th>
                    <th class="px-4 py-3 font-semibold">Qty</th>
                    <th class="px-4 py-3 font-semibold">Price</th>
                    <th class="px-4 py-3 font-semibold">Amount</th>
                    <th class="px-4 py-3 font-semibold">Currency</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows->count == 0) { })
                    <tr>
                        <td colspan="6" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">No medicine rows yet. Add one above.</td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows->count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].medicine_name); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].qty); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].price); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].amount); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows->items[i].currency); })</td>
                        <td class="px-4 py-2 whitespace-nowrap">
                            <form method="POST" action="/patient-medicine-invoices/({ LLINT(import_id); })/details/({ LLINT(rows->items[i].medicine_id); })/delete" class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">Delete</button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
    <a href="/patient-medicine-invoices" class="inline-block mt-4 px-4 py-2 rounded bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200">&larr; Back to invoices</a>
</div>