<div class="max-w-2xl mx-auto">
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Edit Patient Medicine Invoice</h2>
    <form method="POST" action="/patient-medicine-invoices/({ LLINT(id); })/update"
          class="p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <div class="mb-3">
            <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Patient</label>
            <input type="text" value="({ ESCAPED(patient_name); })" disabled
                   class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400">
        </div>
        <div class="mb-3">
            <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Invoice Date</label>
            <input name="invoice_date" type="date" value="({ ESCAPED(invoice_date); })"
                   class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        </div>
        <div class="mb-3">
            <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Amount (Riel)</label>
            <input name="amount_in_riel" type="number" step="any" value="({ ESCAPED(amount_in_riel); })"
                   class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        </div>
        <div class="mb-3">
            <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Amount ($)</label>
            <input name="amount_in_dollar" type="number" step="any" value="({ ESCAPED(amount_in_dollar); })"
                   class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        </div>
        <button type="submit" class="px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Save</button>
        <a href="/patient-medicine-invoices" class="ml-2 px-4 py-2 rounded bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200">Cancel</a>
    </form>
</div>