<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Organization Balance</h2>

    <form method="POST" action="/organization-balance/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">Add Balance</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Organization</label>
                <select name="organization_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < org_opts->count; ++i) { })
                        <option value="({ LLINT(org_opts->items[i].id); })">({ ESCAPED(org_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Org Invoice</label>
                <select name="organization_invoice_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select --</option>
                    ({ for (size_t i = 0; i < inv_opts->count; ++i) { })
                        <option value="({ LLINT(inv_opts->items[i].id); })">({ ESCAPED(inv_opts->items[i].label); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Balance Amount</label>
                <input name="balance_amount" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Balance</label>
                <input name="balance" type="number" step="any"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
        </div>
        <button type="submit" class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Add</button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">Organization</th>
                    <th class="px-4 py-3 font-semibold">Invoice</th>
                    <th class="px-4 py-3 font-semibold">Balance Amount</th>
                    <th class="px-4 py-3 font-semibold">Balance</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows->count == 0) { })
                    <tr>
                        <td colspan="5" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">No balances yet.</td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows->count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].org_name); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">#({ LLINT(rows->items[i].invoice_id); }) ({ ESCAPED(rows->items[i].invoice_label); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].balance_amount); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows->items[i].balance); })</td>
                        <td class="px-4 py-2 whitespace-nowrap">
                            <form method="POST" action="/organization-balance/({ LLINT(rows->items[i].org_id); })/({ LLINT(rows->items[i].invoice_id); })/delete" class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">Delete</button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
</div>