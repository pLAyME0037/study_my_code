<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">
        Invoice Out #({ LLINT(import_id); })
    </h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
        Patient: ({ ESCAPED(patient_name); }) &middot; Room: ({ ESCAPED(room_name); })
    </p>

    <form method="POST" action="/patient-invoice-out/({ LLINT(import_id); })/details/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">Link Daily Invoice</h3>
        <div class="mb-3">
            <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
                Daily Invoice
            </label>
            <select name="patient_daily_invoice_id" required
                    class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                <option value="">-- select --</option>
                ({ for (size_t i = 0; i < daily_opts->count; ++i) { })
                    <option value="({ LLINT(daily_opts->items[i].id); })">
                        ({ ESCAPED(daily_opts->items[i].label); })
                    </option>
                ({ } })
            </select>
        </div>
        <button type="submit" class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">
            Add
        </button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">Daily Invoice #</th>
                    <th class="px-4 py-3 font-semibold">Invoice Date</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows->count == 0) { })
                    <tr>
                        <td colspan="3" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">No linked daily invoices yet.</td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows->count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">#({ LLINT(rows->items[i].daily_id); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows->items[i].daily_label); })</td>
                        <td class="px-4 py-2 whitespace-nowrap">
                            <form method="POST" action="/patient-invoice-out/({ LLINT(import_id); })/details/({ LLINT(rows->items[i].daily_id); })/delete" class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">Delete</button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
    <a href="/patient-invoice-out" class="inline-block mt-4 px-4 py-2 rounded bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200">&larr; Back to invoice out</a>
</div>
