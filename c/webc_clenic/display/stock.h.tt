<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">
        Medicine Stock
    </h2>

    <form method="POST" action="/medicine-stock/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">Add Stock</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Medicine</label>
                <select name="medicine_id" required
                        class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <option value="">-- select medicine --</option>
                    ({ for (size_t i = 0; i < opts.count; ++i) { })
                        <option value="({ LLINT(opts.items[i].id); })">({ ESCAPED(opts.items[i].name); })</option>
                    ({ } })
                </select>
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Stock Qty</label>
                <input name="stock_qty" type="number" step="any" required
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
            <div class="mb-3">
                <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">Last Import Date</label>
                <input name="date_last_import" type="date"
                       class="px-3 py-2 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            </div>
        </div>
        <button type="submit"
                class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Add</button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">#</th>
                    <th class="px-4 py-3 font-semibold">Medicine</th>
                    <th class="px-4 py-3 font-semibold">Stock Qty</th>
                    <th class="px-4 py-3 font-semibold">Last Import Date</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows.count == 0) { })
                    <tr>
                        <td colspan="5" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">
                            No stock records yet.
                        </td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows.count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-500 dark:text-gray-400">({ LLINT(rows.items[i].medicine_id); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows.items[i].medicine_name); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows.items[i].stock_qty); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows.items[i].date_last_import); })</td>
                        <td class="px-4 py-2 whitespace-nowrap">
                            <a href="/medicine-stock/({ LLINT(rows.items[i].medicine_id); })/edit"
                               class="mr-2 px-2 py-1 rounded text-xs bg-amber-500 hover:bg-amber-600 text-white">Edit</a>
                            <form method="POST" action="/medicine-stock/({ LLINT(rows.items[i].medicine_id); })/delete" class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">Delete</button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
</div>
