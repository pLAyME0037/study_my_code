<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">
        Medicine Stock
    </h2>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">#</th>
                    <th class="px-4 py-3 font-semibold">Medicine</th>
                    <th class="px-4 py-3 font-semibold">Stock Qty</th>
                    <th class="px-4 py-3 font-semibold">Last Import Date</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows.count == 0) { })
                    <tr>
                        <td colspan="4" class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">
                            No medicines yet.
                        </td>
                    </tr>
                ({ } else for (size_t i = 0; i < rows.count; ++i) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-500 dark:text-gray-400">({ LLINT(rows.items[i].medicine_id); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows.items[i].medicine_name); })</td>
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">({ ESCAPED(rows.items[i].stock_qty); })</td>
                        <td class="px-4 py-2 text-gray-600 dark:text-gray-300">({ ESCAPED(rows.items[i].date_last_import); })</td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
</div>