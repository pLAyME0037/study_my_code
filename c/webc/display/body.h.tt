<aside class="shrink-0 hidden md:flex flex-col border-r border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 transition-all duration-300 ({ CLS(sidebar_collapsed, "w-16", "w-64") })"
    <div class="relative group mb-1">
        <a href=""
            class="flex items-center rounded-lg transition-all duration-200 ease-in-out ({ CLS(sidebar_collapsed,
                "justify-center px-2",
                "w-full p-2") }) ({ CLS(sidebar_collapsed,
                "bg-indigo-50 text-indigo-600 dark:bg-indigo-900/50 dark:text-indigo-300",
                "text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-200") })">

            <svg class="w-5 h-5 shrink-0 transition-colors ({ CLS(sidebar_collapsed,
                        "text-indigo-600 dark:text-indigo-400",
                        "text-gray-400 group-hover:text-gray-500 dark:text-gray-500 dark:group-hover:text-gray-300") })"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24">
            </svg>

            ({ if (sidebar_collapsed) { })
                <span class="ml-3 text-sm font-medium whitespace-nowrap flex-1 transition-opacity duration-200">
                    Label
                </span>
            ({ } })

            ({ if (sidebar_collapsed && is_active) { })
                <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full ml-2"></span>
            ({ } })
        </a>

        ({ if (sidebar_collapsed) { })
            <div class="absolute left-14 top-1.5 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-50 whitespace-nowrap pointer-events-none shadow-lg">
                Label Tooltip
            </div>
        ({ } })
    </div>
<aside>

({ for (int i = 0; i <= 10; ++i) { })
    <h3 style="color: #fff2f2;"
        class="p-1 text-sm font-bold">Header ({ INT(i) })</h3>
({ } })

<div>
    <table>
        <thead style="background-color: #1e1e2e;">
            <tr style="background-color: #b4befe;"
                class="text-gray-800">
                ({ for (int headers = 0; headers <= 3; ++headers) { })
                    <th>
                        Column ({ INT(headers) })
                    </th>
                ({ } })
            </tr>
        </thead>
        <tbody style="background-color: #a6e3a1;">
            ({ for (int row = 0; row <= 2; ++row) { })
                <tr style="background-color: #a6e3a1;"
                    class="text-gray-700">
                    ({ for (int rows = 0; rows <= 3; ++rows) { })
                        <th>
                            <button onclick="alert('Hello Row: ({ INT(row) }) Column: ({ INT(rows) })')">
                                Row ({ INT(row) })
                            </button>
                        </th>
                    ({ } })
                </tr>
            ({ } })
        </tbody>
    </table>
</div>

